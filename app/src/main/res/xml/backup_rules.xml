<?xml version="1.0" encoding="utf-8"?>
<!-- Android < 12. The encrypted API-key file is useless without its Keystore key, which is
     never backed up: restoring one without the other crashes the app at startup. -->
<full-backup-content>
    <exclude domain="sharedpref" path="jarvis_secure_prefs.xml" />
</full-backup-content>
