<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same exclusion for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="jarvis_secure_prefs.xml" />
        <exclude domain="file" path="meetings" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="jarvis_secure_prefs.xml" />
        <exclude domain="file" path="meetings" />
    </device-transfer>
</data-extraction-rules>
