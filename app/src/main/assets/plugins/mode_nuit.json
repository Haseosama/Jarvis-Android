{
  "name": "mode_nuit",
  "description": "Prépare le téléphone pour la nuit : baisse le volume puis ouvre les réglages d'affichage. À utiliser pour « mode nuit » ou « je vais dormir ».",
  "parameters": [
    {
      "name": "volume",
      "description": "Volume en pourcentage (0 à 100)",
      "required": false
    }
  ],
  "type": "routine",
  "steps": [
    {
      "tool": "device_settings",
      "args": {
        "action": "set_volume",
        "value": "{volume}"
      }
    },
    {
      "tool": "device_settings",
      "args": {
        "action": "open_settings",
        "page": "display"
      }
    }
  ]
}
